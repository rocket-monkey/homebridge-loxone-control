{
  "displayName": "Homebridge Loxone Control",
  "name": "homebridge-loxone-control",
  "type": "module",
  "version": "3.0.0",
  "description": "Homebridge plugin to control a loxone system trough the web-interface - useful if you have zero access to the Miniserver",
  "author": "Remo Vetere <remo.vetere@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rocket-monkey/homebridge-loxone-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocket-monkey/homebridge-loxone-control.git"
  },
  "bugs": {
    "url": "https://github.com/rocket-monkey/homebridge-loxone-control/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "loxone"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^2.4.0"
  },
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "lint:fix": "eslint src/**.ts --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "postbuild": "node scripts/copyScripts.mjs",
    "prepublishOnly": "npm run lint && npm run build",
    "docker:build": "docker build -t homebridge-loxone .",
    "docker:run": "docker run --rm --name homebridge-loxone -p 8581:8581 -p 51827:51827 -p 18081:18081 --shm-size=1g -v homebridge-loxone-data:/homebridge homebridge-loxone",
    "docker:start": "npm run docker:build && npm run docker:run",
    "docker:stop": "docker stop homebridge-loxone",
    "docker:logs": "docker logs -f homebridge-loxone",
    "docker:shell": "docker exec -it homebridge-loxone bash"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6",
    "homebridge-lib": "^8.1.5",
    "puppeteer": "25.12.0",
    "username": "7.0.0",
    "yauzl": "^3.4.0"
  }
}
